# Version control and CI
.git
.github
.gitignore

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Secrets -- must never enter the build context, let alone the image.
# Credentials belong only in a `docker run -e` / --env-file at runtime
# (see src/secrets.py's policy). This mirrors .gitignore's own rule.
.env
*.env

# Local persistent state and user-supplied data -- these are meant to
# be bind-mounted at runtime (see the Dockerfile's VOLUME and
# docker-compose.yml), never baked into the image.
state/
data/
output/
*.db

# Editor/OS cruft
.DS_Store
.idea/
.vscode/
