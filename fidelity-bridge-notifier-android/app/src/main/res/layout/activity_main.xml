<?xml version="1.0" encoding="utf-8"?>
<!-- The screen (built by MainActivity's screens) over the tab bar, on the
     ground colour of the account shown: yellow for Alpaca, green for Fidelity.
     The Connect screen hides the tab bar: it has its own Save and connect. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- With more than one account: a chip each, the one shown filled with its
         broker's colour. MainActivity fills it; hidden on Connect. -->
    <HorizontalScrollView
        android:id="@+id/account_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/account_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/nav_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/nav_home"
            style="@style/NavTab"
            android:drawableTop="@drawable/ic_nav_home"
            android:text="@string/nav_home" />

        <TextView
            android:id="@+id/nav_lots"
            style="@style/NavTab"
            android:drawableTop="@drawable/ic_nav_lots"
            android:text="@string/nav_lots" />

        <TextView
            android:id="@+id/nav_activity"
            style="@style/NavTab"
            android:drawableTop="@drawable/ic_nav_activity"
            android:text="@string/nav_activity" />
    </LinearLayout>
</LinearLayout>
