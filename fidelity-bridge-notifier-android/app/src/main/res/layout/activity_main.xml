<?xml version="1.0" encoding="utf-8"?>
<!-- The screen (built by MainActivity's screens) over the tab bar. The Connect
     screen hides the tab bar: it has its own Save and connect. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/nav_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/nav_home"
            style="@style/NavTab"
            android:drawableTop="@drawable/ic_nav_home"
            android:text="@string/nav_home" />

        <TextView
            android:id="@+id/nav_lots"
            style="@style/NavTab"
            android:drawableTop="@drawable/ic_nav_lots"
            android:text="@string/nav_lots" />

        <TextView
            android:id="@+id/nav_activity"
            style="@style/NavTab"
            android:drawableTop="@drawable/ic_nav_activity"
            android:text="@string/nav_activity" />
    </LinearLayout>
</LinearLayout>
