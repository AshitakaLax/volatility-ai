<?xml version="1.0" encoding="utf-8"?>
<!-- The settings hold the bridge's notification key: never backed up, never
     copied to another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
