<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: each screen draws its own header (MainActivity). -->
    <style name="Base.Theme.BridgeNotifier" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/card</item>
    </style>

    <style name="Theme.BridgeNotifier" parent="Base.Theme.BridgeNotifier" />
</resources>
