    <string name="address_help">Port 8766 on the computer running fidelity-bridge. From outside your home network, over a VPN.</string>
    <string name="key_label">App key</string>
    <string name="key_hint">FIDELITY_BRIDGE_NOTIFY_KEY</string>
    <string name="key_help">On the bridge\'s computer, run python -m fidelity_gateway.bridge keygen --notify and paste the key it prints. It is not the extension\'s key.</string>
