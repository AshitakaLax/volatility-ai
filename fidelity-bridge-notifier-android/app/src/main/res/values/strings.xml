    <string name="header_notify_me">Notify me about</string>
    <string name="notify_save_first">Save the account to choose what it notifies you about. Each account has its own.</string>
    <string name="account_mute">Mute %1$s</string>
    <string name="account_mute_help">Muted, it never buzzes the phone. What it says still shows on its Activity page, and a test you send still arrives.</string>
    <string name="account_muted_short">muted</string>
    <string name="chip_muted">%1$s (muted)</string>
    <string name="account_muted_until">Quiet until %1$s, from a notification. Tap to unmute.</string>
    <string name="muted_until_toast">%1$s muted until %2$s</string>
    <string name="account_summary">Trades in one end-of-day summary</string>
    <string name="account_summary_help">Buys, sales, orders and trading windows stop buzzing one by one: one note after the close sums up the day (after 20:05 New York if the trader is still going). A trade that is a problem, like a sale below cost, still comes at once, and every trade is still on Activity.</string>
    <plurals name="missed_more">
        <item quantity="one">%1$s · and %2$d more while away</item>
        <item quantity="other">%1$s · and %2$d more while away</item>
    </plurals>
    <string name="alert_unreachable">Tell me when an account cannot be reached for 2 minutes (10 while it restarts)</string>
    <string name="alert_unreachable_help">For every account that is not muted</string>
    <string name="lock_title">Locked</string>
    <string name="lock_body">Unlock with your fingerprint, face or screen lock to see your accounts. Notifications keep arriving while the app is locked.</string>
    <string name="lock_button">Unlock</string>
    <string name="lock_prompt_title">Unlock Bridge Notifier</string>
    <string name="lock_prompt_subtitle">Your accounts and their keys</string>
    <string name="lock_setting">Lock with fingerprint, face or screen lock</string>
    <string name="lock_setting_help">Asked when the app opens, and when it comes back after a minute away. It locks the app\'s pages only: notifications still arrive.</string>
    <string name="lock_unavailable">This phone has no screen lock, so the app cannot be locked. Set a PIN, pattern or password in Android\'s settings.</string>
    <string name="open_at_start">Open this page at start-up</string>
    <string name="open_at_start_help">Off: start on Home once an account is set (on All accounts, with more than one)</string>
    <string name="update_setting">Tell me when a newer version is out</string>
    <string name="update_setting_help">Asks GitHub for this app\'s latest release twice a day at most. Nothing about you or your accounts is sent, and nothing is installed by itself: the release page opens in your browser.</string>
    <string name="update_check_now">Check now</string>
    <string name="update_get_version">Get %1$s</string>
    <string name="update_installed">This is %1$s.</string>
    <string name="update_checking">Asking GitHub…</string>
    <string name="update_failed">Could not ask GitHub: %1$s.</string>
    <string name="update_latest">Latest release: %1$s (%2$s), checked %3$s.</string>
    <string name="update_no_version">no app version in its name</string>
    <string name="update_never">Not checked yet.</string>
    <string name="update_title">Bridge Notifier %1$s is out</string>
    <string name="update_body">You have %1$s. Open the release and install its APK over this one: your accounts and keys stay.</string>
    <string name="update_body_reinstall">You have %1$s. One of the two is a debug build, so Android installs the new one only after this app is uninstalled, which forgets its accounts and keys.</string>
    <string name="update_get">Get it</string>
    <string name="update_dismiss">Close</string>
    <string name="group_app">This app</string>
    <string name="watching">Watch your accounts</string>
    <string name="watching_on">On: the app keeps its connections open and shows what each listener says, with the screen off too.</string>
    <string name="watching_off">Off: nothing is shown or announced until this is on again.</string>
    <string name="watching_unset">Enter an account\'s address and key, then Save and connect.</string>
    <string name="notifications_turn_on">Turn notifications on</string>
    <string name="battery_restricted">Android may delay or stop this app\'s connections to save battery, so alerts can arrive late.</string>
    <string name="battery_allow">Let it run in the background</string>
    <string name="settings_unavailable">This phone does not offer that setting here. Look under Settings, Apps, Bridge Notifier.</string>
    <string name="test_asked">Asked %1$s for a test notification.</string>
    <string name="test_not_connected">Not connected to %1$s, so no test can be sent. Save and connect first.</string>
