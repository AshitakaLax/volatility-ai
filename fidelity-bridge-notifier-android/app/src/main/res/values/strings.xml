    <!-- Connect: the settings and connection page -->
    <string name="connect_title">Your accounts</string>
    <string name="connect_intro">The app only listens. Nothing here can place, cancel or change an order. Each account is a listener: the Fidelity bridge, or the trader notifier for an Alpaca deployment.</string>
    <string name="accounts_header">Accounts</string>
    <string name="accounts_none">None yet. Enter a listener\'s address and key below.</string>
    <string name="account_add">Add an account</string>
    <string name="account_new_header">New account</string>
    <string name="account_edit">Edit %1$s</string>
    <string name="account_remove">Remove this account</string>
    <string name="account_remove_title">Remove %1$s?</string>
    <string name="account_remove_body">The app stops watching it and forgets its key. Nothing changes at the listener.</string>
    <string name="account_remove_confirm">Remove</string>
