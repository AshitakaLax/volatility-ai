    <string name="link_idle">not watching</string>
    <string name="address_label">Address</string>
    <string name="address_hint">192.168.1.10 or 192.168.1.10:8767</string>
    <string name="address_help">Fidelity: port 8766 on the computer running fidelity-bridge. Alpaca: port 8767 on the one running trader-notifier; add /notifications/&lt;deployment&gt; for one other than its first. From outside your home network, over a VPN.</string>
    <string name="key_label">App key</string>
    <string name="key_hint">The listener\'s app key</string>
    <string name="key_help">On the listener\'s computer, run python -m fidelity_gateway.bridge keygen --notify (Fidelity) or keygen --notifier (Alpaca) and paste the key it prints. Never the extension\'s key.</string>
    <string name="show_key">Show key</string>
    <string name="hide_key">Hide key</string>
    <string name="check_header">Connection check</string>
    <string name="check_reachable">Listener reachable</string>
    <string name="check_reachable_yes">%1$s answered</string>
    <string name="check_reachable_no">Not reached yet</string>
    <string name="check_reachable_waiting">Not reached: %1$s</string>
    <string name="check_key">Key accepted</string>
    <string name="check_key_yes">Signed messages are flowing</string>
    <string name="check_key_refused">Refused: %1$s</string>
    <string name="check_key_wait">Checked once the bridge answers</string>
    <string name="check_test">Test notification</string>
    <string name="check_test_yes">Received %1$s</string>
    <string name="check_test_wait">Send one to check alerts reach this phone</string>
    <string name="header_notify_me">Notify me about</string>
    <string name="notify_save_first">Save the account to choose what it notifies you about. Each account has its own.</string>
    <string name="account_mute">Mute %1$s</string>
    <string name="account_mute_help">Muted, it never buzzes the phone. What it says still shows on its Activity page, and a test you send still arrives.</string>
    <string name="account_muted_short">muted</string>
    <string name="chip_muted">%1$s (muted)</string>
    <string name="alert_unreachable">Tell me when an account cannot be reached for 2 minutes (10 while it restarts)</string>
    <string name="alert_unreachable_help">For every account that is not muted</string>
    <string name="open_at_start">Open this page at start-up</string>
    <string name="open_at_start_help">Off: start on Home once an account is set</string>
    <string name="plaintext_warning">ws:// is not encrypted. Messages are signed, so they cannot be forged, but anyone on this network can read them. From outside your home network, reach the bridge over a VPN (WireGuard, Tailscale). Never open its port to the internet.</string>
    <string name="notifications_off">Notifications are off for this app, so nothing will be shown. Turn them on in the system settings.</string>
    <string name="send_test">Send test</string>
    <string name="save_and_watch">Save and connect</string>
    <string name="stop_watching">Stop watching</string>
