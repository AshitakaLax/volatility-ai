<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The same screen in the dark: no action bar either, and the same named
         colours, which values-night/colors.xml turns dark. -->
    <style name="Base.Theme.BridgeNotifier" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/card</item>
    </style>
</resources>
