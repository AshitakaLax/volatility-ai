# Fidelity deployment: REAL money, traded by the engine with no one in the
# loop, through the Fidelity Bridge browser extension.
#
# Copy to config/fidelity_live.yaml -- git-ignored, because it names your
# account and this repository is public -- and fill in the account fields.
#
#   1. python -m fidelity_gateway.bridge keygen
#        writes FIDELITY_BRIDGE_API_KEY to .env and prints it once.
#   2. Load the extension (fidelity-bridge-chrome-extension/), paste the key
#      and 127.0.0.1 into its welcome form, and sign into Fidelity there.
#   3. python cli.py live --config config/fidelity_live.yaml \
#          --state-db state/fidelity_ledger.db --check-only
#        connects, reconciles against the account, and stops at READY.
#   4. Turn on "Allow trading" in the extension's toolbar popup, then run
#      the same command without --check-only.
#
# Turning "Allow trading" off at any time pauses the engine's orders --
# it keeps reading and applying fills, and every order is refused in the
# browser -- and turning it back on resumes them. Nothing to restart.
#
# Prices and the market clock come from Alpaca: APCA_API_KEY_ID and
# APCA_API_SECRET_KEY for an Alpaca PAPER account must be in the
# environment. That connection is never handed an order.
#
# The account may hold other investments: this deployment reconciles only
# backtest.symbol. Do not also hold that symbol by hand in the same
# account -- nothing could tell those shares from the deployment's.
strategy:
  strategy_id: fixed
  strategy_params:
    allocation_pct: 0.05
grid:
  steps: [0.01]
  profit_targets: [0.005]
backtest:
  symbol: TQQQ
  # The budget this deployment trades, not the account balance. Size it so
  # allocation_pct of it buys at least one whole share: Fidelity orders are
  # whole shares, and a buy worth less than one share stops the loop.
  initial_cash: 5000.0
execution:
  # T+1: proceeds in a cash IRA cannot be spent until they settle.
  settlement_days: 1
live:
  enabled: true
  paper_trading: false
  step: 0.01
  profit_target: 0.005
  poll_interval_seconds: 60
  broker: fidelity
  # What the Live page may do (engine/core/config.py LiveControlConfig);
  # pausing new buys is always allowed. Resume buys clears a halt -- with
  # real money only once you type the deployment's id back. Without it, a
  # halt (a pause, a book that disagrees with the account) is cleared by hand.
  control:
    resume_buys: true
  # Fidelity's own trading windows (docs/DEPLOY.md, "Pre-market and
  # after-hours"): pre_market 07:00-09:28 ET, regular, after_hours to 20:00.
  # Naming them starts the engine engine_lead_minutes before the first and
  # places orders only inside them, every one a limit. Left out, the
  # deployment trades the regular session as before.
  # sessions: [pre_market, regular]
  # engine_lead_minutes: 30
  # Fidelity's real-time quote behind Alpaca's bars: limit prices, a
  # cross-check, and a minute Alpaca has no bar for outside regular hours.
  # secondary_feed: {enabled: true}
  fidelity:
    allowed_accounts: ["YOUR-FULL-ACCOUNT-NUMBER"]
    account: "YOUR-FULL-ACCOUNT-NUMBER"
    account_name: "Traditional IRA"   # exactly as Fidelity lists the account
    dry_run: false                    # false = REAL orders
    allowed_symbols: [TQQQ]           # must include backtest.symbol
    max_order_value: 500.0            # per BUY; a larger buy is refused, never trimmed
    # journal_path: state/fidelity_orders.jsonl   # default: beside --state-db
    bridge:
      host: 127.0.0.1                 # 0.0.0.0 only if the browser is on another machine...
      port: 8765
      allowed_clients: ["127.0.0.1", "::1"]   # ...and then name that machine's IP here
      connect_timeout_seconds: 120
      # true lets the extension's Algorithm page change the strategy, its
      # parameters, live.step and live.profit_target of this running
      # deployment -- kept beside --state-db as algorithm.json, applied at
      # the next tick. Nothing else (account, symbol, limits) can change.
      allow_algorithm_changes: false
      # Notifications on your phone: the Fidelity Bridge Notifier app
      # (fidelity-bridge-notifier-android/) connects to the fidelity-bridge
      # service here, between sessions too, with its own key (`python -m
      # fidelity_gateway.bridge keygen --notify`). Read-only: nothing the app
      # sends reaches the extension or Fidelity. An edit here is picked up
      # within 30 s without dropping the extension.
      notifications:
        enabled: false
        host: 127.0.0.1               # 0.0.0.0 for a phone on your network...
        port: 8766                    # not the extension's port
        allowed_clients: ["127.0.0.1", "::1"]   # ...and then its range, e.g. 192.168.1.0/24
        # What is sent at all; the app chooses again which it shows. Left out,
        # every kind but order_update (accepted, cancelled, expired):
        # events: [buy, sell, order_problem, engine, session, readiness, fidelity_signin,
        #          account_check, connected, disconnected, trading_switch, refused, bridge]
